#!/bin/sh
# 公開リポジトリへ実データが流れるのを機械的に止める。
#
# なぜフックなのか: 「push 前に確認する」というルールは 2026-08-24 に破られた。
# ルールを書いた本人が、その直後に実名を公開リポジトリの main へ push している。
# 思い出す前提の手順は機能しないので、思い出さなくても止まる形にする。
#
# 有効化:  git config core.hooksPath tools/hooks
# 迂回:    git push --no-verify   （通したいときは明示的に。判断が記録に残る）

set -u
RED=$(printf '\033[31m'); OFF=$(printf '\033[0m')
fail=0

# 実名は環境ごとに違うので設定から読む。未設定なら実名チェックは行わない
#   git config --add hooks.secretname '名前'
NAMES=$(git config --get-all hooks.secretname 2>/dev/null || true)

# 金額らしき数字。円記号付き、または3桁区切りのカンマを含む数値
# （このコメント自身が引っかからないよう、例は書かない）
# 実データの金額は3桁以上か3桁区切りを伴う。¥0 のようなコード上の
# リテラルまで拾うと誤検出だらけになり、フックが無視されるようになる
MONEY='¥[0-9]{3,}|¥[0-9]{1,3},[0-9]{3}|[0-9]{1,3},[0-9]{3}'

while read -r _local_ref local_sha _remote_ref remote_sha; do
    # ブランチ削除は検査しない
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac

    if echo "$remote_sha" | grep -qE '^0+$'; then
        # 新規ブランチ。リモートに既にあるコミットまで見ると、過去の分まで
        # 拾って誤検出になる。**まだ push されていないぶんだけ**を対象にする
        base=$(git rev-list "$local_sha" --not --remotes=origin 2>/dev/null | tail -1)
        if [ -n "$base" ]; then
            base=$(git rev-parse "$base^" 2>/dev/null || echo "")
        fi
        [ -z "$base" ] && continue              # 新しいコミットが無ければ何もしない
        range="$base..$local_sha"
        added=$(git diff "$base" "$local_sha" 2>/dev/null | grep '^+' || true)
    else
        range="$remote_sha..$local_sha"
        added=$(git diff "$remote_sha" "$local_sha" 2>/dev/null | grep '^+' || true)
    fi
    msgs=$(git log --format='%B' "$range" 2>/dev/null || true)

    check() {   # $1=対象名 $2=中身 $3=パターン $4=表示名
        hits=$(printf '%s\n' "$2" | grep -nE "$3" | head -5 || true)
        [ -z "$hits" ] && return 0
        printf '%s✗ %s に「%s」が含まれています%s\n' "$RED" "$1" "$4" "$OFF"
        printf '%s\n' "$hits" | sed 's/^/    /'
        fail=1
    }

    for n in $NAMES; do
        [ -n "$n" ] || continue
        check "追加行"           "$added" "$n"    "実名（$n）"
        check "コミットメッセージ" "$msgs"  "$n"    "実名（$n）"
    done
    check "追加行"           "$added" "$MONEY" "金額らしき数字"
    check "コミットメッセージ" "$msgs"  "$MONEY" "金額らしき数字"
done

if [ "$fail" -ne 0 ]; then
    cat <<'MSG'

  push を中断しました。公開リポジトリに実データを載せないためのチェックです。

  よくある原因: ローカル版のコメントや docstring をまとめてコピーすると、
  根拠として書いてある実額やサービス名がそのまま入ります。
  理由は残し、具体の数字だけ落としてください
  （例:「1日あたりが2割近くずれた」）。

  誤検出だと確信できる場合のみ:  git push --no-verify
MSG
    exit 1
fi
exit 0
